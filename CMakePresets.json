{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "c50c-v1_1",
      "displayName": "C50C V1.1 firmware",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchain-arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "VK_PLATFORM": "stm32f4",
        "VK_BOARD": "c50c-v1_1"
      }
    },
    {
      "name": "c50c-v1_1-bringup",
      "displayName": "C50C V1.1 bring-up test build (L4)",
      "inherits": "c50c-v1_1",
      "cacheVariables": { "VK_DEBUG_OVERLAY": "${sourceDir}/test/hardware/bringup.config" }
    },
    {
      "name": "sitl",
      "displayName": "SITL on the development host",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VK_PLATFORM": "sitl",
        "VK_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "test",
      "displayName": "Host tests",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VK_PLATFORM": "sitl",
        "VK_BUILD_TESTS": "ON",
        "VK_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Link fuzz targets (libFuzzer, Clang)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang-18",
        "CMAKE_CXX_COMPILER": "clang++-18",
        "VK_PLATFORM": "sitl",
        "VK_BUILD_FUZZERS": "ON",
        "VK_CLANG_TIDY": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "c50c-v1_1", "configurePreset": "c50c-v1_1" },
    { "name": "c50c-v1_1-bringup", "configurePreset": "c50c-v1_1-bringup" },
    { "name": "sitl", "configurePreset": "sitl" },
    { "name": "test", "configurePreset": "test" },
    { "name": "fuzz", "configurePreset": "fuzz", "targets": ["vk_fuzzers"] }
  ],
  "testPresets": [
    {
      "name": "test",
      "configurePreset": "test",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 3 }
    }
  ]
}
