# Extensions are downloaded separately (see extensions/README.md), never committed
extensions/*
!extensions/README.md

# Vendor ROS 2 SDK is too large for GitHub (~2.2 GB); the rest of vendor/ is committed
vendor/*wheeltec_ros2_src*/

# Firmware build output
examples/build/

# AHRS Bench: host build of the filters and recorded sessions
tools/ahrs_bench/.build/
tools/ahrs_bench/recordings/

# Python bytecode
__pycache__/
