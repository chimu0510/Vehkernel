#!/usr/bin/env python3
"""Show the Wheeltec chassis models from the extension in RViz, one at a time.

Switch models from the RViz right-click menu on the model label, or:
  ros2 param set /model_viewer model top_4wd_bs_robot
  ros2 service call /model_viewer/next std_srvs/srv/Trigger
  ros2 service call /model_viewer/prev std_srvs/srv/Trigger
  ros2 service call /model_viewer/list std_srvs/srv/Trigger
"""

from geometry_msgs.msg import Point, TransformStamped
from interactive_markers import InteractiveMarkerServer, MenuHandler
import rclpy
from rclpy.node import Node
from rclpy.parameter import Parameter
from rclpy.parameter_client import AsyncParameterClient
from rcl_interfaces.msg import SetParametersResult
from sensor_msgs.msg import JointState
from std_srvs.srv import Trigger
from tf2_ros import StaticTransformBroadcaster
from visualization_msgs.msg import InteractiveMarker, InteractiveMarkerControl, Marker

from ugv_model_viewer.catalog import Catalog, family_of

WORLD_FRAME = 'world'


def _metres(value):
    return '-' if value is None else f'{value:.3f}'


class ModelViewer(Node):

    def __init__(self):
        super().__init__('model_viewer')
        self.declare_parameter('urdf_dir', '')
        self.declare_parameter('model', '')
        self.declare_parameter('cycle_period', 0.0)

        self.catalog = Catalog(self.get_parameter('urdf_dir').value)
        self.models = self.catalog.models
        self.current = None
        self.summary = None

        self.joint_pub = self.create_publisher(JointState, 'joint_states', 10)
        self.static_tf = StaticTransformBroadcaster(self)
        self.rsp = AsyncParameterClient(self, 'robot_state_publisher')
        self.menu_server = InteractiveMarkerServer(self, 'model_menu')
        self.menu, self.menu_targets = MenuHandler(), {}
        self._build_menu()

        self.create_service(Trigger, '~/next', lambda req, res: self._step(res, 1))
        self.create_service(Trigger, '~/prev', lambda req, res: self._step(res, -1))
        self.create_service(Trigger, '~/list', self._list)
        self.add_on_set_parameters_callback(self._validate_params)
        self.add_post_set_parameters_callback(self._apply_params)
        self.create_timer(0.1, self._publish_joint_states)
        self.cycle_timer = None
        self._configure_cycle(self.get_parameter('cycle_period').value)

        self.show(self.get_parameter('model').value or self.models[0])

    # Model switching

    def show(self, model):
        if model == self.current:
            return
        self.current, self.summary = model, self.catalog.summary(model)
        if self.get_parameter('model').value != model:
            self.set_parameters([Parameter('model', value=model)])

        if self.rsp.wait_for_services(timeout_sec=5.0):
            self.rsp.set_parameters(
                [Parameter('robot_description', value=self.catalog.description(model))])
        else:
            self.get_logger().error('robot_state_publisher parameter service not available')

        self.static_tf.sendTransform(self._world_to_root())
        self._publish_label()
        self.get_logger().info(self._label_text().replace('\n', ' | '))

    def _step(self, response, offset):
        index = (self.models.index(self.current) + offset) % len(self.models)
        self.show(self.models[index])
        response.success, response.message = True, self.current
        return response

    def _list(self, request, response):
        response.success = True
        response.message = '\n'.join(f'{family_of(m)}: {m}' for m in self.models)
        return response

    # Parameters

    def _validate_params(self, params):
        for param in params:
            if param.name == 'model' and param.value and param.value not in self.models:
                return SetParametersResult(successful=False,
                                           reason=f"unknown model '{param.value}'")
            if param.name == 'urdf_dir':
                return SetParametersResult(successful=False, reason='urdf_dir is read-only')
        return SetParametersResult(successful=True)

    def _apply_params(self, params):
        for param in params:
            if param.name == 'model' and param.value:
                self.show(param.value)
            elif param.name == 'cycle_period':
                self._configure_cycle(param.value)

    def _configure_cycle(self, period):
        if self.cycle_timer is not None:
            self.destroy_timer(self.cycle_timer)
            self.cycle_timer = None
        if period > 0.0:
            self.cycle_timer = self.create_timer(period, lambda: self._step(Trigger.Response(), 1))

    # Publishing

    def _publish_joint_states(self):
        msg = JointState()
        msg.header.stamp = self.get_clock().now().to_msg()
        msg.name = [name for name, _ in self.summary.movable_joints]
        msg.position = [position for _, position in self.summary.movable_joints]
        self.joint_pub.publish(msg)

    def _lift(self):
        # Rest the model on the RViz grid (z = 0 is the ground).
        return 0.0 if self.summary.bbox_min is None else -float(self.summary.bbox_min[2])

    def _world_to_root(self):
        tf = TransformStamped()
        tf.header.stamp = self.get_clock().now().to_msg()
        tf.header.frame_id = WORLD_FRAME
        tf.child_frame_id = self.summary.root_link
        tf.transform.translation.z = self._lift()
        tf.transform.rotation.w = 1.0
        return tf

    def _label_text(self):
        s = self.summary
        lines = [f'{self.current}  ({self.models.index(self.current) + 1}/{len(self.models)})',
                 family_of(self.current)]
        if s.bbox_min is not None:
            length, width, height = s.bbox_max - s.bbox_min
            lines.append(f'size  L {length:.3f}  W {width:.3f}  H {height:.3f} m')
        lines.append(f'track {_metres(s.track)}  wheelbase {_metres(s.wheelbase)}  '
                     f'wheel D {_metres(s.wheel_diameter)} m')
        lines.append('right-click for models')
        return '\n'.join(lines)

    def _publish_label(self):
        s, lift = self.summary, self._lift()
        top = 0.3 if s.bbox_max is None else float(s.bbox_max[2]) + lift

        text = Marker(type=Marker.TEXT_VIEW_FACING, text=self._label_text())
        text.pose.position.z = top + 0.12
        text.scale.z = 0.035
        text.color.r = text.color.g = text.color.b = text.color.a = 1.0

        control = InteractiveMarkerControl(
            interaction_mode=InteractiveMarkerControl.MENU, always_visible=True, markers=[text])
        if s.bbox_min is not None:
            control.markers.append(self._bbox_marker(lift))

        marker = InteractiveMarker(name='model', description='', scale=0.2, controls=[control])
        marker.header.frame_id = WORLD_FRAME
        self.menu_server.insert(marker)
        self.menu.apply(self.menu_server, marker.name)
        self.menu_server.applyChanges()

    def _bbox_marker(self, lift):
        lo, hi = self.summary.bbox_min.copy(), self.summary.bbox_max.copy()
        lo[2] += lift
        hi[2] += lift
        corners = [Point(x=float(x), y=float(y), z=float(z))
                   for x in (lo[0], hi[0]) for y in (lo[1], hi[1]) for z in (lo[2], hi[2])]
        edges = [(0, 1), (2, 3), (4, 5), (6, 7), (0, 2), (1, 3),
                 (4, 6), (5, 7), (0, 4), (1, 5), (2, 6), (3, 7)]
        box = Marker(type=Marker.LINE_LIST)
        box.points = [corners[i] for edge in edges for i in edge]
        box.scale.x = 0.003
        box.color.r, box.color.g, box.color.b, box.color.a = 1.0, 0.8, 0.2, 0.8
        return box

    def _build_menu(self):
        self.menu.insert('Next model', callback=lambda fb: self._step(Trigger.Response(), 1))
        self.menu.insert('Previous model', callback=lambda fb: self._step(Trigger.Response(), -1))
        families = {}
        for model in self.models:
            family = family_of(model)
            if family not in families:
                families[family] = self.menu.insert(family)
            entry = self.menu.insert(model, parent=families[family], callback=self._on_menu)
            self.menu_targets[entry] = model

    def _on_menu(self, feedback):
        self.show(self.menu_targets[feedback.menu_entry_id])


def main():
    rclpy.init()
    node = ModelViewer()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
