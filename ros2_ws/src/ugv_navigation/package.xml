<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ugv_navigation</name>
  <version>0.1.0</version>
  <description>Navigation and mapping configuration for WHEELTEC C50C UGV (SLAM Toolbox, Nav2, EKF)</description>
  <maintainer email="developer@wheeltec.local">UGV Developer</maintainer>
  <license>GPL-3.0-or-later</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ugv_description</exec_depend>
  <exec_depend>ugv_base</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
