# Build-time configuration (ADR-0017): Kconfig decides what the firmware
# contains; parameters decide what is enabled after boot. Layers are merged in
# order: MCU (or SITL) defaults, board defaults, debug overlay.
mainmenu "Vehkernel configuration"

# Hardware facts. The board generator emits a fragment that turns on the ones
# a board has; they are declared here so options can depend on them on every
# platform, including SITL.
config BOARD_HAS_CAN
	bool

config BOARD_HAS_FLASH_PARAMS
	bool

config BOARD_HAS_ICM20948
	bool

config BOARD_IMU_BUS_SOFT_I2C
	bool

config BOARD_HAS_LINK_PORT
	bool

source "$(VK_BOARD_KCONFIG)"

choice PLATFORM
	prompt "Platform"

config PLATFORM_STM32F4
	bool "STM32F4"

config PLATFORM_SITL
	bool "SITL on the development host"

endchoice

menu "Vehicle models"

config VEHICLE_MODEL_WHEELED
	bool "WHEELED (differential, skid-steer, mecanum, omni)"
	default y

config VEHICLE_MODEL_ACKERMANN
	bool "ACKERMANN"

config VEHICLE_MODEL_THRUSTER
	bool "THRUSTER"

endmenu

menu "Estimators"

config ESTIMATOR_MAHONY
	bool "Mahony attitude estimator"
	depends on DRIVER_ICM20948
	default y
	select MATH_QUATERNION
	help
	  Attitude from the IMU with the Mahony complementary filter
	  (ADR-0014), published on vehicle_attitude.

endmenu

menu "Drivers"

config DRIVER_CAN
	bool "CAN bus"
	depends on BOARD_HAS_CAN

config DRIVER_ICM20948
	bool "ICM20948 IMU"
	depends on BOARD_HAS_ICM20948 || PLATFORM_SITL
	default y
	help
	  TDK InvenSense ICM20948 accelerometer and gyroscope on I2C; the
	  magnetometer inside it is not used yet.

config SOFT_I2C
	bool "Software I2C on two GPIO pins"
	depends on BOARD_IMU_BUS_SOFT_I2C || PLATFORM_SITL
	default y
	help
	  Bit-banged I2C with open-drain lines, for board devices wired to
	  pins hardware I2C cannot use (ADR-0015).

endmenu

menu "Storage"

config PARAM_STORAGE_FLASH
	bool "Parameters in internal Flash"
	depends on BOARD_HAS_FLASH_PARAMS
	default y

endmenu

menu "Links"

config LINK
	bool "Links with the custom protocol"
	default y
	help
	  The custom protocol of ADR-0002: COBS and CRC16 framing, handshake
	  with schema hashes, time synchronization, and parameter access
	  (ADR-0012).

config LINK_SERIAL
	bool "Link on a board serial port"
	depends on LINK && PLATFORM_STM32F4 && BOARD_HAS_LINK_PORT
	default y
	help
	  A Link on the board's first serial port whose function is LINK,
	  SERIAL1 (the Type-C port) on the C50C V1.1, at 921600 baud 8N1
	  until the parameter system exists. UART transmit and receive use
	  DMA.

config LINK_UDP
	bool "Link over UDP"
	depends on LINK && PLATFORM_SITL
	default y
	help
	  SITL's default Link transport (ADR-0018). The address and port are
	  chosen on the command line, 127.0.0.1:15600 by default.

config LINK_PTY
	bool "Link over a pseudo-terminal"
	depends on LINK && PLATFORM_SITL
	default y
	help
	  An optional SITL Link transport, chosen with --link pty, for
	  testing tools against a real serial API without hardware
	  (ADR-0018).

endmenu

menu "Testing"

config BRINGUP_TESTS
	bool "Bring-up test build (replaces the application)"
	depends on PLATFORM_STM32F4 && SOFT_I2C && BOARD_HAS_ICM20948
	help
	  Builds a firmware that runs the L4 bring-up cases at boot, writes
	  the results to a RAM block for the bring-up runner to read over SWD,
	  then idles (ADR-0018). It never configures actuator outputs.

endmenu

# Helper libraries. Only these may be pulled in with select.
config MATH_QUATERNION
	bool
